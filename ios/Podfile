# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# iOS 15.5, not React Native's 15.1. It was forced by `VisionCameraBarcodeScanner` (the ML Kit QR
# reader, 006 T012b / 025), which declared `:ios => 15.5` - CocoaPods refused to resolve below it, which
# is how CI found this the first time iOS was ever built (2026-09-16). That pod is gone since 2026-09-24
# (QR codes are now read by Apple's own AVCaptureMetadataOutput through VisionCamera's core, which
# follows React Native's minimum), so nothing requires 15.5 any more; the floor is kept where it was
# rather than lowered to a version the app has never been built or run on. Taken as the HIGHER of the
# two so a future React Native bump raises this floor rather than silently lowering it.
platform :ios, [Gem::Version.new(min_ios_version_supported), Gem::Version.new('15.5')].max.to_s
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

use_modular_headers!

target 'ObalkaDatovaSchranka' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # The phone-to-phone transfer (025 T022): the native module and the Go archive it links, which
  # scripts/build-transfer-xcframework.sh builds. Without the archive the pod compiles to nothing and
  # the app has no transfer (FR-013); see the podspec.
  pod 'ObalkaTransferModule', :path => './ObalkaTransferModule'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
