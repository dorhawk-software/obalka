#!/usr/bin/env bash
# No credential committed by accident: Trivy with this project's rules
# (.trivy-secret.yaml, which knows the Sentry token forms the stock rules
# miss) over what git would commit. Git-ignored files are left out: a build
# writes the real Sentry token into ios/ and android/sentry.properties, and
# git never takes those. CI runs the same scan over the checkout.
#
# A canary first: a planted fake token must be flagged, or the rules aren't
# loaded and a clean result means nothing (common/gates.md).
set -uo pipefail
if ! command -v trivy >/dev/null; then
    echo "trivy isn't installed (brew install trivy): the secret scan can't run."
    exit 1
fi
canary=$(mktemp -d)
trap 'rm -rf "$canary"' EXIT
printf 'auth.token=sntrys_%s\n' 'eyJpYXQiOjE3MDAwMDAwMDB9=_NOTAREALTOKEN000000' >"$canary/sentry.properties"
if trivy fs --quiet --scanners secret --secret-config .trivy-secret.yaml --exit-code 1 "$canary" >/dev/null 2>&1; then
    echo "The secret scan did not flag a planted Sentry token: its rules aren't loaded, so it checks nothing."
    exit 1
fi
skip_dirs=node_modules
skip_files=
while IFS= read -r path; do
    case $path in
        */) skip_dirs="$skip_dirs,${path%/}" ;;
        *) skip_files="${skip_files:+$skip_files,}$path" ;;
    esac
done < <(git ls-files --others --ignored --exclude-standard --directory)
trivy fs --quiet --scanners secret --secret-config .trivy-secret.yaml \
    --ignorefile .trivyignore.yaml --skip-dirs "$skip_dirs" \
    ${skip_files:+--skip-files "$skip_files"} --exit-code 1 .
