# .practices/config: Obálka's settings for the scripts in .practices/bin
# (shell KEY=value lines). The defaults are in .practices/bin/lib.sh. This
# file is the project's own: practices updates never change it.

# The git-ignored list of names never to commit (dev/private-terms).
PRIVATE_TERMS=dev/private-terms

# The npm scripts the gate runs after `tsc --noEmit` (under a second each,
# measured 2026-11-12), and the tests pre-commit runs (jest, about 13 s).
NPM_CHECKS='lint changelog:check attributions:check'
NPM_TEST='test'

# Generated code nobody edits by hand: the ISDS types (codegen-isds) and
# the in-app changelog and licence lists.
SIZE_EXCLUDE='(\.generated\.ts$|/generated/)'

# The copy people read, for check-voice (practices 1.6.0, common/voice.md): every
# source file (the strings, the FAQ, copy in components), the public pages
# (README, PRIVACY, SECURITY, the changelogs that are What's new), the store
# listing and the native permission texts. Generated files are left out:
# the in-app changelog is CHANGELOG*.md's copy and the attributions quote
# third-party licences. The kit's default read only src/i18n and missed the
# FAQ's "ani my" and the privacy page's "nám" (2026-11-16).
VOICE_FILES=':(glob)src/** :(glob)CHANGELOG*.md :(glob)PRIVACY*.md :(glob)README*.md :(glob)SECURITY.md :(glob)docs/store/** :(glob)ios/ObalkaDatovaSchranka/Info.plist :(glob)android/app/src/main/res/values*/strings.xml :(exclude,glob)**/*.generated.*'

# The copy whose grammar check-copy reads (practices 1.7, common/voice.md): the
# catalogues that hold it in `cs` and `en` blocks, and the FAQ. Its default is
# VOICE_FILES, all of src/, where component styles, SOAP tags and schema files
# read as copy in no language: 310 findings, none about grammar. Left out too:
# dates.ts and typeset.ts (format data), activeLocale.ts and serverMessages.ts
# (ids) (2026-11-16).
COPY_FILES=':(glob)src/i18n/*Strings.ts src/i18n/strings.ts src/i18n/loginMessages.ts src/content/faq.ts'
