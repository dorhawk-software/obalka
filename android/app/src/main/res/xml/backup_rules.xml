<?xml version="1.0" encoding="utf-8"?>
<!--
  The same rule as `data_extraction_rules.xml`, for Android 11 (API 30) and older, which read this
  file instead: nothing of this app goes into the phone's own backup. Owner decision, 2026-09-24 -
  the reasons are in that file.

  `allowBackup="false"` already switches backup off on these versions, cloud and phone-to-phone
  alike, so this is the second lock rather than the only one: it keeps the answer "nothing" if that
  flag is ever turned back on.

  `full-backup-content` has no separate device-transfer section: on these versions a phone-to-phone
  transfer runs through the same backup agent, so the same exclusions govern it. Pinned by
  `__tests__/security/androidBackupRules.test.ts`.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
